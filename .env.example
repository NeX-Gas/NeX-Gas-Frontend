# URL WebSocket backend NeX-Gas-Backend (gateway `/ws`).
# Kosongkan untuk mode demo/simulator lokal.
# Contoh: ws://localhost:5001/ws atau wss://api.nex-gas.id/ws
NEXT_PUBLIC_WS_URL=

# URL REST backend (login, snapshot, riwayat, perintah).
# Contoh: http://localhost:5001 atau https://api.nex-gas.id
NEXT_PUBLIC_API_URL=

# ID alat; harus sama dengan DEFAULT_DEVICE_ID di backend.
NEXT_PUBLIC_DEVICE_ID=nexgas-001

# Kompatibilitas: nama lama untuk WebSocket (dipakai kalau NEXT_PUBLIC_WS_URL kosong).
NEXT_PUBLIC_DEVICE_WS_URL=
